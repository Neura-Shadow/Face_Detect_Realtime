# Phase 13C TensorRT FP16 edge perception — example environment file.
#
# Copy OUTSIDE the repository before editing. Never commit a filled-in .env.
# This template contains no secrets, and Phase 13C never requires any.
#
#   cp deployment/jetson/phase13c.env.example ~/ma-vlna-phase13c.env
#   set -a; . ~/ma-vlna-phase13c.env; set +a
#
# Every model asset stays EXTERNAL to the repository and is never committed,
# never downloaded and never auto-installed.

# ── Identity ────────────────────────────────────────────────────────────────
MA_VLNA_PHASE13C_RUN_ID=

# ── Model target (FP16 only; INT8 is Phase 13D) ─────────────────────────────
MA_VLNA_PHASE13C_MODEL_FAMILY=yolov9
MA_VLNA_PHASE13C_MODEL_VARIANT=yolov9-c
MA_VLNA_PHASE13C_PRECISION=fp16
MA_VLNA_PHASE13C_BATCH_SIZE=1
MA_VLNA_PHASE13C_INPUT_SIZE=640

# ── External assets on the Jetson ───────────────────────────────────────────
MA_VLNA_PHASE13C_ASSET_ROOT=/home/myjetsonnx/models/ma-vlna/yolov9
MA_VLNA_PHASE13C_ONNX=/home/myjetsonnx/models/ma-vlna/yolov9/yolov9-c-640-b1.onnx
MA_VLNA_PHASE13C_MODEL_MANIFEST=/home/myjetsonnx/models/ma-vlna/yolov9/yolov9-c-640-b1.manifest.json
MA_VLNA_PHASE13C_ENGINE=/home/myjetsonnx/models/ma-vlna/yolov9/yolov9-c-640-b1-trt852-fp16.engine
MA_VLNA_PHASE13C_ENGINE_MANIFEST=/home/myjetsonnx/models/ma-vlna/yolov9/yolov9-c-640-b1-trt852-fp16.manifest.json
# Class names come from the external source tree, never from this repository.
MA_VLNA_PHASE13C_CLASS_NAMES=/home/myjetsonnx/models/ma-vlna/yolov9/coco.yaml

# ── External assets on the Windows export host (reference only) ─────────────
# YOLOV9_ROOT=D:\AIModels\yolov9
# YOLOV9_WEIGHTS=D:\AIModels\yolov9\yolov9-c-converted.pt

# ── Engine build ────────────────────────────────────────────────────────────
# The engine is ALWAYS built on this Jetson; a serialized plan is never copied
# in from another machine.
MA_VLNA_PHASE13C_INPUT_SHAPE=1x3x640x640
MA_VLNA_PHASE13C_WORKSPACE_BYTES=1073741824
MA_VLNA_PHASE13C_BUILDER=auto
MA_VLNA_TRTEXEC=/usr/src/tensorrt/bin/trtexec

# ── CUDA allocator ──────────────────────────────────────────────────────────
# PyCUDA and cuda-python are NOT installed in the Jetson venv and must not be
# installed automatically; Phase 13C drives libcudart through ctypes instead.
MA_VLNA_CUDART_PATH=/usr/local/cuda/lib64/libcudart.so

# ── Postprocess profile (identical on both parity backends) ─────────────────
MA_VLNA_PHASE13C_PROFILE=yolov9-c
MA_VLNA_PHASE13C_CONFIDENCE_THRESHOLD=0.25
MA_VLNA_PHASE13C_NMS_IOU_THRESHOLD=0.45
MA_VLNA_PHASE13C_MAX_DETECTIONS=300

# ── Deadline budget ─────────────────────────────────────────────────────────
# latency_budget_ms = command_validity_ms - clock_uncertainty_ms - safety_margin_ms
MA_VLNA_PHASE13C_COMMAND_VALIDITY_MS=1000
MA_VLNA_PHASE13C_SAFETY_MARGIN_MS=50
MA_VLNA_PHASE13C_MAX_INFERENCE_MS=1000

# ── Benchmark ───────────────────────────────────────────────────────────────
MA_VLNA_PHASE13C_WARMUP=50
MA_VLNA_PHASE13C_ITERATIONS=300

# ── Runtime ─────────────────────────────────────────────────────────────────
MA_VLNA_PHASE13C_PERCEPTION_BACKEND=tensorrt
MA_VLNA_PHASE13C_REQUIRE_NO_FALLBACK=1
MA_VLNA_PHASE13C_OUTPUT_DIR=experiments/phase13
MA_VLNA_PHASE13C_REPO=/home/myjetsonnx/Face_Detect_Realtime
MA_VLNA_PHASE13C_VENV=/home/myjetsonnx/venvs/ma-vlna
