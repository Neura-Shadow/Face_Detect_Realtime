# Phase 13B Jetson-in-the-loop bridge — example environment file.
#
# Copy to a location OUTSIDE the repository (or to a path matched by .gitignore)
# before editing. Never commit a filled-in .env. This template contains no
# secrets, no passwords and no keys, and Phase 13B never requires any.
#
#   cp deployment/jetson/phase13b.env.example ~/ma-vlna-phase13b.env
#   set -a; . ~/ma-vlna-phase13b.env; set +a

# ── Identity ────────────────────────────────────────────────────────────────
# The PC generates the run id and passes the SAME id to the Jetson.
MA_VLNA_PHASE13B_RUN_ID=

# ── Network ─────────────────────────────────────────────────────────────────
# Current Phase 13B transport is L4T USB Device Mode Ethernet (l4tbr0), not
# RJ45 and not Gigabit Ethernet.
MA_VLNA_PHASE13B_TRANSPORT_MEDIUM=usb_gadget_ethernet
MA_VLNA_PHASE13B_BIND_HOST=0.0.0.0
# Detect the real PC source address for the route to the Jetson before a run;
# do not assume 192.168.55.100 if routing has changed.
MA_VLNA_PHASE13B_PC_HOST=192.168.55.100

# Jetson listeners
MA_VLNA_PHASE13B_FRAME_PORT=13510
MA_VLNA_PHASE13B_CONTROL_PORT=13513
MA_VLNA_PHASE13B_ACK_PORT=13512
# PC listener
MA_VLNA_PHASE13B_COMMAND_PORT=13511

# ── Bounded buffering ───────────────────────────────────────────────────────
MA_VLNA_PHASE13B_POOL_SIZE=3
MA_VLNA_PHASE13B_MAX_PAYLOAD_BYTES=4194304
MA_VLNA_PHASE13B_JPEG_QUALITY=85

# ── Diagnostic control policy (NOT a navigation policy) ─────────────────────
MA_VLNA_PHASE13B_DIAGNOSTIC_THROTTLE=0.20
MA_VLNA_PHASE13B_DIAGNOSTIC_CONFIDENCE=0.90
MA_VLNA_PHASE13B_COMMAND_VALIDITY_MS=500
MA_VLNA_PHASE13B_NOMINAL_RESULT_AGE_MS=20

# ── Clock domain ────────────────────────────────────────────────────────────
MA_VLNA_PHASE13B_MAX_CLOCK_UNCERTAINTY_US=5000
MA_VLNA_PHASE13B_ACK_TIMEOUT_MS=500
MA_VLNA_PHASE13B_STALE_FRAME_MS=2000

# ── Telemetry ───────────────────────────────────────────────────────────────
MA_VLNA_PHASE13B_TEGRASTATS_INTERVAL_MS=1000
MA_VLNA_PHASE13B_OUTPUT_DIR=experiments/phase13

# ── Paths ───────────────────────────────────────────────────────────────────
MA_VLNA_PHASE13B_REPO=/home/myjetsonnx/Face_Detect_Realtime
MA_VLNA_PHASE13B_VENV=/home/myjetsonnx/venvs/ma-vlna
