# Phase 13F environment file EXAMPLE for the supervised Jetson node service.
#
# Copy to the path referenced by EnvironmentFile= in the unit (for example
# /etc/ma-vlna/jetson-node.env), adjust, and chmod 0640 root:<service group>.
#
# This file is an example and is committed. The real file is NOT committed:
# it is host-specific and is the only place a secret would ever live. Nothing
# here is shell-expanded into the ExecStart command line, so values never
# appear in `ps` output or in journald metadata.
#
# systemd EnvironmentFile syntax: KEY=value, one per line, no `export`, no
# shell quoting or command substitution. Values are literal.

# Peer PC running the CARLA simulation host and the C Virtual Safety MCU.
MA_VLNA_PC_HOST=192.168.55.100

# Interface the node binds its listeners to.
MA_VLNA_BIND_HOST=0.0.0.0

# Phase 13B/13E-R port assignment. Must match the PC driver.
MA_VLNA_FRAME_PORT=48701
MA_VLNA_CONTROL_PORT=48702
MA_VLNA_COMMAND_PORT=48703
MA_VLNA_ACK_PORT=48704

# Commit the service is authorised to run. Startup preflight compares this
# against the repository's actual HEAD and withholds AI authority on mismatch,
# so a half-finished pull cannot silently become the running service.
MA_VLNA_EXPECTED_SHA=0000000000000000000000000000000000000000

# Optional: CUDA device ordering, if the host ever exposes more than one.
# CUDA_DEVICE_ORDER=PCI_BUS_ID
# CUDA_VISIBLE_DEVICES=0
