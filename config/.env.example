# ============================================================
# MA-VLNA — Memory-Augmented Vision-Language Navigation Agent
# 環境變數範本（.env.example）
# ============================================================

# ---- Supabase ----
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-or-service-role-key
SUPABASE_STORAGE_BUCKET=scene-frames

# ---- 資料表名稱 ----
VEHICLE_STATUS_TABLE=vehicle_status
SCENE_LOGS_TABLE=scene_logs
TRAJECTORY_MEMORY_TABLE=trajectory_memory

# ---- VLM Reasoner（OpenAI-compatible 格式）----
# 支援的 VLM_PROVIDER: local_stub, openai_compatible, gemma
VLM_PROVIDER=openai_compatible
VLM_API_BASE=http://localhost:8000/v1
VLM_MODEL=gemma-4-27b-it
VLM_API_KEY=optional
VLM_TIMEOUT_SEC=30
VLM_CONFIDENCE_THRESHOLD=0.4
VLM_MAX_RETRIES=2

# ---- Embedding 模型 ----
EMBEDDING_MODEL_NAME=openai/clip-vit-large-patch14
EMBEDDING_DIMENSION=768

# ---- 場景記憶 ----
SCENE_SIMILARITY_THRESHOLD=0.82
UNKNOWN_SCENE_THRESHOLD=0.55
MEMORY_TOP_K=5

# ---- Camera / 影像來源 ----
CAMERA_SOURCE=0
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720

# ---- Edge Perception ----
PERCEPTION_BACKEND=dummy
DETECTION_MODEL=yolov8n.pt
PERCEPTION_CONFIDENCE=0.5
TRACKER_TYPE=bytetrack

# ---- Planner ----
PLANNER_MAX_WAYPOINTS=20
PLANNER_SAFETY_MARGIN=1.5
PLANNER_DEADLOCK_THRESHOLD=5

# ---- Backend API ----
API_HOST=0.0.0.0
API_PORT=8080

# ---- 車輛 / Agent ID ----
VEHICLE_ID=vehicle-001
